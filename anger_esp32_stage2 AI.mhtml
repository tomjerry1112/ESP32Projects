#include &lt;math.h&gt;

void compute_xi_vector(
    const float mfcc[MFCC_BANDS][MFCC_FRAMES],
    float xi[XI_DIM]
)
{
    for (int band =3D 0; band &lt; MFCC_BANDS; band++) {

        float sum =3D 0.0f;
        float maximum =3D -INFINITY;
        float minimum =3D INFINITY;

        for (int frame =3D 0; frame &lt; MFCC_FRAMES; frame++) {

            float v =3D mfcc[band][frame];

            sum +=3D v;

            if (v &gt; maximum) maximum =3D v;
            if (v &lt; minimum) minimum =3D v;
        }

        float mean =3D sum / MFCC_FRAMES;

        float variance =3D 0.0f;

        for (int frame =3D 0; frame &lt; MFCC_FRAMES; frame++) {

            float diff =3D mfcc[band][frame] - mean;

            variance +=3D diff * diff;
        }

        float stddev =3D sqrtf(
            variance / MFCC_FRAMES
        );

        int base =3D band * 4;

        xi[base + 0] =3D mean;
        xi[base + 1] =3D stddev;
        xi[base + 2] =3D maximum;
        xi[base + 3] =3D minimum;
    }
}<!--/if--><!--/try-b--><!--/try--><!--/comp--></code></pre><!----><!----><=
