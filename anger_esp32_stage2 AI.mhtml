-if-->#include &lt;stdio.h&gt;
#include &lt;math.h&gt;

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

#include "esp_log.h"
#include "esp_heap_caps.h"

#include "microphone.h"

static const char *TAG =3D "SPEAKER";

extern "C" void app_main(void)
{
    ESP_LOGI(TAG, "Speaker recognition firmware starting");

    ESP_ERROR_CHECK(microphone_init());

    float *audio =3D static_cast&lt;float *&gt;(
        heap_caps_malloc(
            AUDIO_SAMPLES * sizeof(float),
            MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT
        )
    );

    if (!audio) {
        ESP_LOGE(TAG, "Cannot allocate audio buffer");
        return;
    }

    while (true) {

        ESP_LOGI(TAG, "Recording...");

        ESP_ERROR_CHECK(
            microphone_read(audio, AUDIO_SAMPLES)
        );

        float sum =3D 0.0f;
        float peak =3D 0.0f;

        for (int i =3D 0; i &lt; AUDIO_SAMPLES; i++) {

            float v =3D fabsf(audio[i]);

            sum +=3D v;

            if (v &gt; peak) {
                peak =3D v;
            }
        }

        float mean =3D sum / AUDIO_SAMPLES;

        ESP_LOGI(
            TAG,
            "Audio: mean=3D%.6f peak=3D%.6f",
            mean,
            peak
        );

        vTaskDelay(pdMS_TO_TICKS(200));
    }
}<!--/if--><!--/try-b--><!--/try--><!--/comp--></code></pre><!----><!----><=
