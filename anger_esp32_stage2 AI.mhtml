#include &lt;stdlib.h&gt;
#include &lt;stdint.h&gt;

#include "driver/i2s_std.h"
#include "esp_log.h"
#include "esp_heap_caps.h"

static const char *TAG =3D "MIC";

#define I2S_BCLK GPIO_NUM_4
#define I2S_WS   GPIO_NUM_5
#define I2S_DIN  GPIO_NUM_6

static i2s_chan_handle_t rx_handle =3D nullptr;

esp_err_t microphone_init()
{
    i2s_chan_config_t chan_cfg =3D
        I2S_CHANNEL_DEFAULT_CONFIG(
            I2S_NUM_0,
            I2S_ROLE_MASTER
        );

    ESP_ERROR_CHECK(
        i2s_new_channel(
            &amp;chan_cfg,
            nullptr,
            &amp;rx_handle
        )
    );

    i2s_std_config_t std_cfg =3D {};

    std_cfg.clk_cfg =3D
        I2S_STD_CLK_DEFAULT_CONFIG(
            AUDIO_SAMPLE_RATE
        );

    std_cfg.slot_cfg =3D
        I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(
            I2S_DATA_BIT_WIDTH_32BIT,
            I2S_SLOT_MODE_MONO
        );

    std_cfg.slot_cfg.slot_mask =3D I2S_STD_SLOT_LEFT;

    std_cfg.gpio_cfg.mclk =3D I2S_GPIO_UNUSED;
    std_cfg.gpio_cfg.bclk =3D I2S_BCLK;
    std_cfg.gpio_cfg.ws =3D I2S_WS;
    std_cfg.gpio_cfg.dout =3D I2S_GPIO_UNUSED;
    std_cfg.gpio_cfg.din =3D I2S_DIN;

    std_cfg.gpio_cfg.invert_flags.mclk_inv =3D false;
    std_cfg.gpio_cfg.invert_flags.bclk_inv =3D false;
    std_cfg.gpio_cfg.invert_flags.ws_inv =3D false;

    ESP_ERROR_CHECK(
        i2s_channel_init_std_mode(
            rx_handle,
            &amp;std_cfg
        )
    );

    ESP_ERROR_CHECK(
        i2s_channel_enable(rx_handle)
    );

    ESP_LOGI(TAG, "INMP441 initialized");

    return ESP_OK;
}

esp_err_t microphone_read(
    float *output,
    size_t sample_count
)
{
    if (!output || !rx_handle) {
        return ESP_ERR_INVALID_ARG;
    }

    int32_t *raw =3D static_cast&lt;int32_t *&gt;(
        heap_caps_malloc(
            4096 * sizeof(int32_t),
            MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT
        )
    );

    if (!raw) {
        return ESP_ERR_NO_MEM;
    }

    size_t written_samples =3D 0;

    while (written_samples &lt; sample_count) {

        size_t remaining =3D
            sample_count - written_samples;

        size_t request_samples =3D
            remaining &gt; 4096 ? 4096 : remaining;

        size_t bytes_read =3D 0;

        esp_err_t err =3D i2s_channel_read(
            rx_handle,
            raw,
            request_samples * sizeof(int32_t),
            &amp;bytes_read,
            portMAX_DELAY
        );

        if (err !=3D ESP_OK) {
            heap_caps_free(raw);
            return err;
        }

        size_t count =3D
            bytes_read / sizeof(int32_t);

        if (count =3D=3D 0) {
            continue;
        }

        for (size_t i =3D 0; i &lt; count; i++) {

            // INMP441 24-bit data in a 32-bit slot.
            int32_t sample =3D raw[i] &gt;&gt; 8;

            output[written_samples + i] =3D
                (float)sample / 8388608.0f;
        }

        written_samples +=3D count;
    }

    heap_caps_free(raw);

    return ESP_OK;
}<!--/if--><!--/try-b--><!--/try--><!--/comp--></code></pre><!----><!----><=
